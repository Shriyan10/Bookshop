{*{include '../../common/headers.latte'}*}

{*<h1>Cart Items</h1>*}

{*{foreach $cartDetails as $cartDetail}*}
{*<h1>Title: {$cartDetail->title}</h1>*}
{*<h1>Quantity: {$cartDetail->quantity}</h1>*}
{*<h1>Total Amount: {$cartDetail->totalAmount}</h1>*}
{*{/foreach}*}

{*<h1>Grand Total Amount: {$grandTotal}</h1>*}
{*<a href="#">Checkout</a>*}

{*{include '../../common/footers.latte'}*}
{include '../../common/headers.latte'}


<table class="cart-table">
    <thead>
    <tr>
        <th>Title</th>
        <th>Quantity</th>
        <th>Total Amount</th>
    </tr>
    </thead>
    <tbody>
    {foreach $cartDetails as $cartDetail}
        <tr>
            <td>{$cartDetail->title}</td>
            <td>{$cartDetail->quantity}</td>
            <td>Rs. {$cartDetail->totalAmount}</td>
        </tr>
    {/foreach}
    <tr class="grand-total-row">
        <td colspan="2"><strong>Grand Total</strong></td>
        <td><strong>Rs. {$grandTotal}</strong></td>
    </tr>
    </tbody>
</table>
<div class="checkout-container">
    <a href="javascript:void(0)" onclick="toggleModal()" class="checkout-button">Checkout</a>
</div>

<div id="receipt">
    <div class="overlay"></div>
    <div class="modal-content">
        <h1>BookShop</h1>
        <p>Date: {date("F j, Y")} </p>
        <p>Customer Name: {$LOGGED_IN_USER -> firstName} {$LOGGED_IN_USER -> lastName}</p>
        <p>Payment: Cash on Delivery</p>

        <table class="cart-table">
            <thead>
            <tr>
                <th>S.No.</th>
                <th>Title</th>
                <th>Quantity</th>
                <th>Total Amount</th>
            </tr>
            </thead>
            <tbody>
            {foreach $cartDetails as $key => $cartDetail}
                <tr>
                    <td>{$key + 1}</td>
                    <td>{$cartDetail->title}</td>
                    <td>{$cartDetail->quantity}</td>
                    <td>Rs. {$cartDetail->totalAmount}</td>
                </tr>
            {/foreach}
            <tr class="grand-total-row">
                <td colspan="3"><strong>Grand Total</strong></td>
                <td><strong>Rs. {$grandTotal}</strong></td>
            </tr>
            </tbody>
        </table>
        <p>
            Thank you for choosing us
        </p>
        <a href="javascript:void()" onclick="toggleModal()" class="checkout-button">Close</a>
    </div>


</div>

<style>
    #receipt {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100dvh;
        z-index: 1000;
        text-align: center;


        &.show {
            display: block;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100dvh;
            background: rgb(0 0 0 / 0.35);
            backdrop-filter: blur(5px);
        }

        .modal-content {
            position: relative;
            z-index: 1001;
            width: min(100%, 30rem);
            background: #fff;
            padding: 1rem;
            margin: 10px auto
        }

    }

</style>

<script>

    const reciptModal = document.getElementById('receipt')

    function toggleModal() {
        if (reciptModal.classList.contains('show')) {
            reciptModal.classList.remove('show')
        } else {
            reciptModal.classList.add('show')
        }


    }
</script>